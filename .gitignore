# ==========================================
# Environment Variables (Rahasia)
# ==========================================
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
# Jangan abaikan file template env contoh
!.env.example
!backend/.env.example
!frontend/.env.example

# ==========================================
# Dependencies (Folder Library Besar)
# ==========================================
node_modules/
frontend/node_modules/
backend/node_modules/
vendor/
backend/vendor/

# ==========================================
# Build, Cache & Temporary Files
# ==========================================
dist/
build/
frontend/dist/
frontend/build/
frontend/node_modules/.vite/

# Cache & Sessions Laravel
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/framework/testing/*
backend/storage/oauth-*.key

# Logs
*.log
backend/storage/logs/*.log
npm-debug.log*
yarn-debug.log*

# Database SQLite (jika ada)
*.sqlite
*.sqlite-journal

# ==========================================
# Uploads / Data Spasial Besar
# ==========================================
backend/storage/app/public/thumbnails/
# Tambahkan ekstensi file besar jika ada (opsional)
*.zip
*.rar

# ==========================================
# IDE & OS Files
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini